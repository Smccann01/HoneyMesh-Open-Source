[Unit]
Description=HoneyMesh host protection service
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/honeymesh/honeymesh.json
ConditionPathIsMountPoint=/sys/fs/bpf

[Service]
Type=exec
User=honeymesh
Group=honeymesh
WorkingDirectory=/var/lib/honeymesh
StateDirectory=honeymesh
StateDirectoryMode=0700
ExecStart=/usr/bin/honeymesh -config /etc/honeymesh/honeymesh.json -state-dir /var/lib/honeymesh
Restart=on-failure
RestartSec=5s
LimitMEMLOCK=infinity
NoNewPrivileges=yes
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/honeymesh /sys/fs/bpf
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
